# Server
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (Vite falls back to 5174, 5175, ... if 5173 is taken).
# Add your machine's LAN IP too if testing from another device on the network, e.g.:
# http://localhost:5173,http://localhost:5174,http://192.168.1.50:5173,http://192.168.1.50:5174
# Any LAN host listed here (i.e. not localhost/127.0.0.1) is automatically
# allowed on ANY port, not just the ones listed — this absorbs Vite's
# port-hopping so a second device doesn't get CORS-blocked when 5173/5174
# are both already in use. Only the exact port list is enforced for localhost.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# Base URL used to build links sent in emails (e.g. the employee onboarding
# invite link). Optional — defaults to the first CLIENT_ORIGIN entry above
# when unset. Set this explicitly if that first entry isn't the right one
# for public-facing links (e.g. CLIENT_ORIGIN lists a LAN dev URL first).
# FRONTEND_URL=https://advertisers360.vercel.app

# Database
DB_HOST=replace_with_your_db_host
DB_PORT=3306
DB_NAME=advertiser360_hrms
DB_USER=replace_with_your_db_user
DB_PASSWORD=replace_with_your_db_password

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

# Office rules (overnight shift: 6:00 PM to 1:00 AM)
OFFICE_START_TIME=18:00:00
OFFICE_END_TIME=01:00:00
LATE_GRACE_MINUTES=15

# Attendance auto-mark job (runs daily at this server-local time, after the shift has fully ended)
ATTENDANCE_AUTO_MARK_TIME=02:00

# Office-location-restricted access (employee/manager only — ceo is exempt)
OFFICE_LATITUDE=31.4638622
OFFICE_LONGITUDE=74.4122764
OFFICE_RADIUS_METERS=400
